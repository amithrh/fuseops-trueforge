# The Vite proxy is used for a lightweight readiness check because standalone mode has no CORS headers.
VITE_TRUEFORGE_URL=/trueforge
# The official web client stays on its own origin so its absolute assets and API routes resolve correctly.
VITE_TRUEFORGE_EMBED_URL=http://localhost:8790

# FuseOps' owned Streamable HTTP MCP server and dashboard API. Keep these ports aligned.
PORT=3100
VITE_CONTROL_PLANE_URL=http://localhost:3100

# Use the exact configured TrueForge model FQN, e.g. openai/gpt-5-mini.
TRUEFORGE_MODEL=openai/gpt-5-mini
# Used by agent registration and the Vite development proxy.
TRUEFORGE_BASE_URL=http://localhost:8790
